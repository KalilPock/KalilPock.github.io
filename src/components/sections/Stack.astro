---
import { stack } from "@data/stack";
import Section from "@components/ui/Section.astro";
import SectionHeading from "@components/ui/SectionHeading.astro";
import Tag from "@components/ui/Tag.astro";
---

<Section id="stack" label="Stack">
  <SectionHeading
    eyebrow="02 — stack"
    title="Ferramentas que uso no dia a dia"
    description="O que uso hoje e o que estou estudando agora."
  />

  <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      stack.map((group) => (
        <div class="surface p-5" data-reveal>
          <h3 class="text-base font-semibold text-fg">{group.title}</h3>
          <p class="mt-1 text-xs text-subtle">{group.blurb}</p>
          <ul class="mt-4 flex flex-wrap gap-1.5">
            {group.items.map((item) => (
              <li>
                <Tag label={item} />
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</Section>
