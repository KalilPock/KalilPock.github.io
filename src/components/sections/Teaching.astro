---
import { teaching } from "@data/teaching";
import Section from "@components/ui/Section.astro";
import SectionHeading from "@components/ui/SectionHeading.astro";
import Tag from "@components/ui/Tag.astro";
---

<Section id="ensino" label="Ensino">
  <SectionHeading
    eyebrow="04 — ensino"
    title={teaching.title}
    description={teaching.description}
  />

  <div class="mt-12 grid gap-10 md:grid-cols-[1.55fr_1fr] md:gap-12">
    <div class="space-y-5 text-base leading-relaxed text-muted" data-reveal>
      {teaching.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    <div class="surface p-5" data-reveal>
      <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-subtle">
        Na sala de aula
      </p>
      <ul class="mt-4 flex flex-wrap gap-1.5">
        {
          teaching.topics.map((topic) => (
            <li>
              <Tag label={topic} />
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Section>
