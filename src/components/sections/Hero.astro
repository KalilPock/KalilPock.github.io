---
import { site } from "@data/site";
import Button from "@components/ui/Button.astro";

const { kicker, tagline, secondary, chips } = site.hero;
---

<section id="inicio" class="wrap relative pb-16 pt-14 md:pb-24 md:pt-24">
  <div class="grid items-center gap-12 md:grid-cols-[1.45fr_1fr] md:gap-10">
    <div class="min-w-0">
      <p class="eyebrow flex items-center gap-2">
        <span class="text-subtle">$</span>{kicker}
      </p>

      <h1 class="mt-4 text-[clamp(2.9rem,9vw,5.5rem)] font-semibold leading-[0.92] tracking-tight">
        <span class="text-gradient">KalilPock</span>
      </h1>

      <p class="mt-6 max-w-xl text-lg leading-relaxed text-fg/90 md:text-xl">
        {tagline}
      </p>
      <p class="mt-3 max-w-xl text-sm leading-relaxed text-muted md:text-base">
        {secondary}
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3" data-reveal>
        <Button href="#projetos" variant="primary">
          Ver projetos
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </Button>
        <Button href={site.links.github} variant="ghost" external>
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8a8 8 0 0 0 5.47 7.59c.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.4 7.4 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8 8 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path>
          </svg>
          GitHub
        </Button>
      </div>

      <div
        class="mt-10 flex flex-wrap gap-x-6 gap-y-2 font-mono text-xs text-subtle"
        data-reveal
      >
        <span><span class="text-accent-2">●</span> {site.location}</span>
        {chips.map((chip) => <span>{chip}</span>)}
      </div>
    </div>

    <div class="relative mx-auto w-48 sm:w-56 md:w-full md:max-w-[300px]" data-reveal>
      <div class="absolute inset-4 -z-10 rounded-full bg-accent/20 blur-3xl" aria-hidden="true"></div>
      <div class="relative rounded-[2rem] border border-border bg-bg-elev/70 p-2 shadow-[var(--shadow-glow)]">
        <img
          src="/avatar.svg"
          alt="Avatar de KalilPock: janela de terminal com prompt"
          width="512"
          height="512"
          class="w-full rounded-[1.5rem]"
          loading="eager"
          decoding="async"
        />
        <div class="grid-backdrop pointer-events-none absolute inset-0 rounded-[2rem] opacity-40" aria-hidden="true"></div>
      </div>
      <p class="mt-4 text-center font-mono text-[11px] text-subtle">
        <span class="text-accent">~</span>/kalilpock
      </p>
    </div>
  </div>
</section>
