---
import { site } from "@data/site";
import Section from "@components/ui/Section.astro";
import SectionHeading from "@components/ui/SectionHeading.astro";

const { paragraphs, facts } = site.about;
---

<Section id="sobre" label="Sobre">
  <SectionHeading
    eyebrow="01 — sobre"
    title="Desenvolvo, ensino e mantenho meus próprios serviços"
    description="Desenvolvedor full stack autônomo, professor no ensino técnico e um homelab como laboratório."
  />

  <div class="mt-12 grid gap-10 md:grid-cols-[1.55fr_1fr] md:gap-12">
    <div class="space-y-5 text-base leading-relaxed text-muted" data-reveal>
      {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    <dl class="grid content-start gap-3" data-reveal>
      {
        facts.map((fact) => (
          <div class="surface p-4">
            <dt class="font-mono text-[11px] uppercase tracking-[0.14em] text-subtle">
              {fact.label}
            </dt>
            <dd class="mt-1 text-sm text-fg">{fact.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</Section>
