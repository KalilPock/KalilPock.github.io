---
import { homelab, formatNumber, isStale } from "@data/homelab";
import Section from "@components/ui/Section.astro";
import SectionHeading from "@components/ui/SectionHeading.astro";
import StatCard from "@components/ui/StatCard.astro";

const stale = isStale(homelab.fetchedAt, 24);

const updatedAt = homelab.fetchedAt
  ? new Intl.DateTimeFormat("pt-BR", {
      dateStyle: "medium",
      timeStyle: "short",
      timeZone: "America/Sao_Paulo",
    }).format(new Date(homelab.fetchedAt))
  : null;

const queries = homelab.queries;
const blockedPct = queries.blockedPct.toLocaleString("pt-BR", {
  maximumFractionDigits: 1,
});
---

{
  homelab.available && (
    <Section id="homelab" label="Homelab">
      <SectionHeading
        eyebrow="— homelab"
        title="O laboratório em números"
        description="Um servidor em casa cuidando do DNS da rede. Os números vêm do Pi-hole, coletados no próprio servidor e publicados como snapshot estático."
      />

      <div
        class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-subtle"
        data-reveal
      >
        <span class="inline-flex items-center gap-2 font-mono">
          <span class="h-1.5 w-1.5 rounded-full bg-accent-2" />
          {`pi-hole${homelab.source ? ` · api ${homelab.source}` : ""}`}
        </span>
        {updatedAt && <span>atualizado em {updatedAt}</span>}
        {stale && (
          <span class="rounded-full border border-warn/30 bg-warn/10 px-2 py-0.5 font-mono text-warn">
            snapshot antigo
          </span>
        )}
      </div>

      <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <StatCard
          label="Queries hoje"
          value={formatNumber(queries.today)}
          hint="requisições DNS"
        />
        <StatCard
          label="Bloqueadas"
          value={formatNumber(queries.blocked)}
          hint="anúncios e trackers"
          accent="lime"
        />
        <StatCard
          label="Taxa de bloqueio"
          value={`${blockedPct}%`}
          hint="do total do dia"
          accent="cyan"
        />
        <StatCard
          label="Domínios únicos"
          value={formatNumber(queries.uniqueDomains)}
          hint={`${formatNumber(queries.clients)} clientes ativos`}
        />
      </div>

      {homelab.showDomains && homelab.topBlocked.length > 0 && (
        <div class="surface mt-4 p-5" data-reveal>
          <h3 class="font-mono text-[11px] uppercase tracking-[0.14em] text-subtle">
            Top domínios bloqueados
          </h3>
          <ul class="mt-3 space-y-2">
            {homelab.topBlocked.map((entry) => (
              <li class="flex items-center justify-between gap-4 text-sm">
                <span class="truncate font-mono text-xs text-muted">
                  {entry.domain}
                </span>
                <span class="shrink-0 tabular-nums text-subtle">
                  {formatNumber(entry.count)}
                </span>
              </li>
            ))}
          </ul>
        </div>
      )}
    </Section>
  )
}
