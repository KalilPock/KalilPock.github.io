---
import { projects } from "@data/projects";
import type { ProjectCategory } from "@data/projects";
import Section from "@components/ui/Section.astro";
import SectionHeading from "@components/ui/SectionHeading.astro";
import Tag from "@components/ui/Tag.astro";

const categoryLabels: Record<ProjectCategory, string> = {
  fullstack: "full stack",
  homelab: "homelab",
  "ci-cd": "ci/cd",
};

const filterTabs = [
  { id: "all", label: "Todos" },
  { id: "fullstack", label: "Full Stack" },
  { id: "homelab", label: "Homelab" },
  { id: "ci-cd", label: "CI/CD" },
];
---

<Section id="projetos" label="Projetos">
  <SectionHeading
    eyebrow="03 — projetos"
    title="Projetos e experimentos"
    description="Do sistema de anotações ao homelab que roda meus serviços."
  />

  <div class="mt-8 flex flex-wrap items-center gap-2" data-reveal>
    {
      filterTabs.map((tab, idx) => (
        <button
          type="button"
          data-project-filter={tab.id}
          aria-pressed={idx === 0 ? "true" : "false"}
          class={`rounded-full border px-3.5 py-1.5 font-mono text-xs transition-all duration-200 focus-visible:outline-none ${
            idx === 0
              ? "border-accent bg-accent/10 text-accent"
              : "border-border bg-transparent text-muted hover:border-accent/40 hover:text-fg"
          }`}
        >
          {tab.label}
        </button>
      ))
    }
  </div>

  <div class="mt-8 grid gap-5 md:grid-cols-2">
    {
      projects.map((project) => (
        <article
          class="surface group relative overflow-hidden p-6 transition-opacity duration-200"
          data-reveal
          data-tilt
          data-tilt-max="5"
          data-spotlight
          data-project-category={project.category}
        >
          <div
            data-tilt-glare
            class="pointer-events-none absolute inset-0 rounded-[var(--radius-lg)] opacity-0"
            style="transition: opacity 200ms ease"
            aria-hidden="true"
          >
          </div>

          <div class="flex items-center justify-between gap-3">
            <Tag label={categoryLabels[project.category]} tone="accent" />
            {
              project.status && (
                <span class="font-mono text-xs text-subtle">
                  {project.status}
                </span>
              )
            }
          </div>

          <h3 class="mt-4 text-xl font-semibold text-fg">{project.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">
            {project.summary}
          </p>

          <ul class="mt-4 flex flex-wrap gap-1.5">
            {project.tags.map((tag) => (
              <li>
                <Tag label={tag} />
              </li>
            ))}
          </ul>

          {
            (project.repo || project.demo) && (
              <div class="mt-5 flex flex-wrap gap-4 text-sm">
                {project.repo && (
                  <a
                    href={project.repo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link-underline text-accent"
                    data-cursor="link"
                  >
                    código ↗
                  </a>
                )}
                {project.demo && (
                  <a
                    href={project.demo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link-underline text-accent"
                    data-cursor="link"
                  >
                    demo ↗
                  </a>
                )}
              </div>
            )
          }
        </article>
      ))
    }
  </div>
</Section>
