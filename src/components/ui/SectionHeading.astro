---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<div class="max-w-2xl" data-reveal>
  <p class="eyebrow">{eyebrow}</p>
  <h2 class="mt-3 text-3xl md:text-4xl">{title}</h2>
  {description && <p class="mt-4 text-base text-muted md:text-lg">{description}</p>}
</div>
