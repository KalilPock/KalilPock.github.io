---
import BaseLayout from "@layouts/BaseLayout.astro";
import Button from "@components/ui/Button.astro";
---

<BaseLayout
  title="404 — KalilPock"
  description="A página que você procura não existe."
>
  <section class="wrap flex min-h-[62vh] flex-col items-center justify-center py-20 text-center">
    <p class="eyebrow">erro 404</p>
    <h1 class="mt-4 text-5xl font-semibold md:text-6xl">Página não encontrada</h1>
    <p class="mt-4 max-w-md text-muted">
      O caminho que você tentou não existe — ou foi movido para outro lugar.
    </p>
    <div class="mt-8">
      <Button href="/" variant="primary">Voltar ao início</Button>
    </div>
  </section>
</BaseLayout>
