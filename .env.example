# Pi-hole (somente no servidor do homelab — nunca no cliente)
# Copie para .env no clone do homelab ou use um EnvironmentFile do systemd.
PIHOLE_URL=http://127.0.0.1
PIHOLE_API_KEY=

# Mostrar os domínios mais bloqueados no site (o JSON gerado é público).
# Deixe "false" para exibir apenas números agregados.
PIHOLE_SHOW_DOMAINS=false
